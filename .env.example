# Zkopíruj do .env a vyplň. .env je v .gitignore, tento soubor ne.

# Token od @BotFather (příkaz /newbot), formát <číslo>:<řetězec>
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Chat ID, které smí bota používat (čárkou oddělené). Zjistíš přes @userinfobot.
# Když zůstane prázdné, bot odpoví komukoli, kdo ho najde.
MADEIRA_ALLOWED_CHATS=123456789

# Volitelné: jiná cesta k SQLite databázi (výchozí data/madeira.db)
# MADEIRA_DB=C:\Users\honza\dev-projects\madeira-weather-forecast\data\madeira.db
